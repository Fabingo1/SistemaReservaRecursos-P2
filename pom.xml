<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Proyecto padre: solo agrupa los tres módulos y centraliza versiones y plugins -->
    <groupId>cr.ac.una.eif206</groupId>
    <artifactId>SistemaReservaRecursos-P2</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>comun</module>     <!-- modelo, IService y protocolo: lo comparten los dos procesos -->
        <module>backend</module>   <!-- servidor, lógica y datos (único que toca la BD) -->
        <module>frontend</module>  <!-- vistas, controladores y Proxy (sin nada de BD) -->
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cr.ac.una.eif206</groupId>
                <artifactId>comun</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cr.ac.una.eif206</groupId>
                <artifactId>backend</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Parseo del JSON que devuelve el LLM -->
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>20260814</version>
            </dependency>
            <!-- Driver JDBC de Oracle (compatible con 11g XE) -->
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc8</artifactId>
                <version>19.25.0.0</version>
            </dependency>
            <!-- Generación de reportes PDF -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>3.0.8</version>
            </dependency>
            <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf</artifactId>
                <version>3.7.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- JUnit Jupiter en los tres módulos -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Compila en Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>

            <!-- Unitarios: corre en 'mvn test'. Toma *Test.java e ignora *IT.java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

            <!-- Integración: corre en 'mvn verify', toma *IT.java.
                 El <executions> es obligatorio para conectarlo al ciclo de vida de Maven -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
